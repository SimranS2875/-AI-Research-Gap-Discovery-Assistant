# Copy this file to ".env" and fill in your key. Never commit or share .env.
GEMINI_API_KEY=your-key-here

# Optional overrides (leave blank to auto-detect a current Flash model)
GEMINI_MODEL=
GEMINI_GAP_MODEL=
# "tfidf" = offline similarity (default, no extra API calls); "gemini" = Gemini embeddings
EMBEDDING_BACKEND=tfidf
# Optional: free key from semanticscholar.org/product/api raises literature-search rate limits
S2_API_KEY=

# Seconds between Gemini requests (13 keeps a free key under 5 requests/minute; 0 disables)
GEMINI_MIN_INTERVAL_S=13
